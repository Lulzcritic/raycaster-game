# =========================================================================
# CONFIGURATION DES VARIABLES D'ENVIRONNEMENT - THE OLD CITADEL
# =========================================================================
# ⚠️ NE COMMITEZ JAMAIS VOTRE FICHIER .env SUR GITHUB (IL EST DANS .gitignore).
# 
# Pour configurer vos secrets sur votre machine ou serveur de production :
# 1. Copiez ce fichier :  cp .env.example .env
# 2. Modifiez les mots de passe ci-dessous avec des valeurs fortes.
# 3. Docker Compose chargera automatiquement le fichier .env lors du démarrage.
# =========================================================================

# Port du serveur de jeu HTTP & WebSocket
PORT=3001
NODE_ENV=production

# Mot de passe du tableau de bord d'administration (/admin)
ADMIN_PASSWORD=change_this_to_a_secure_admin_password

# Configuration de la base de données PostgreSQL
POSTGRES_USER=raycaster
POSTGRES_PASSWORD=change_this_to_a_secure_postgres_password
POSTGRES_DB=raycaster_db
POSTGRES_PORT=5433

# URL de connexion à PostgreSQL
# - Sous Docker : la liaison entre conteneurs est 100% automatique (laissez la ligne ci-dessous commentée).
# - Hors Docker uniquement (ex: si vous lancez 'npm run server' sur votre machine hôte) : décommentez la ligne ci-dessous :
# DATABASE_URL=postgresql://raycaster:change_this_to_a_secure_postgres_password@localhost:5433/raycaster_db
