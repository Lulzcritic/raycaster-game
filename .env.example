# =========================================================================
# CONFIGURATION DES VARIABLES D'ENVIRONNEMENT - THE OLD CITADEL
# =========================================================================

# Port du serveur de jeu HTTP & WebSocket
PORT=3001
NODE_ENV=production

# Configuration du conteneur PostgreSQL
POSTGRES_USER=raycaster
POSTGRES_PASSWORD=raycaster_secret
POSTGRES_DB=raycaster_db
POSTGRES_PORT=5432

# URL de connexion à PostgreSQL
# - Pour le conteneur Docker de l'app : postgresql://raycaster:raycaster_secret@postgres:5432/raycaster_db
# - Pour un serveur exécuté en local hors docker (npm run server) : postgresql://raycaster:raycaster_secret@localhost:5432/raycaster_db
DATABASE_URL=postgresql://raycaster:raycaster_secret@localhost:5432/raycaster_db
